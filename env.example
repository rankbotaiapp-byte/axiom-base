# Copy to .env and fill in. Never commit .env.
# Values below are names only. Set the real values in Vercel as server
# environment variables, except NEXT_PUBLIC_SUPABASE_URL, which is public.

# Postgres connection for Supabase. Required on Vercel. Server-only.
# Use the Session pooler (IPv4), NOT the direct host:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Direct db.<ref>.supabase.co is IPv6-only and fails Vercel builds with ENETUNREACH.
DATABASE_URL=
# Optional session / direct URL. migrate.mjs prefers DATABASE_URL / pooler :5432, then this.
DIRECT_URL=

# Public app origin, for example https://your-app.vercel.app. Required.
# Used for Stripe success URLs, signed unsubscribe links, and auth callbacks.
BETTER_AUTH_URL=
# Session signing secret. Required in production. Also signs /api/unsubscribe
# when OUTREACH_UNSUBSCRIBE_SECRET is empty.
BETTER_AUTH_SECRET=

# Stay on simulation until a launch is explicitly switched to live.
OUTREACH_MODE=simulation

# Supabase project URL. Public. Used by the simulation script.
NEXT_PUBLIC_SUPABASE_URL=
# Browser anon key. Public. Required for client Supabase reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role. Server-only. Never prefix this with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Server-only. The webhook secret must be the one Stripe shows for
# the production endpoint, not the local CLI listener secret.
# Secret and publishable must be the same mode (sk_test_ with pk_test_, sk_live_ with pk_live_).
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_LIVE=
# Publishable key for card fields on the booking page. Safe to expose to the
# browser. The server sends it only when a guest starts a payment.
STRIPE_PUBLISHABLE_KEY=

# Recurring $150/mo Price id (price_...) used after the first verified real lead.
# Leave empty to record axiom_pro locally without creating a Stripe subscription.
STRIPE_PRICE_AXIOM_PRO=

# Outreach providers. Stored for launch. Simulation does not call them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional Twilio API key pair (not used by Lookup v2 in this app; SID + AUTH_TOKEN are).
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
# Comma-separated pre-registered 10DLC E.164 numbers for post-checkout assignment.
AXIOM_TWILIO_NUMBER_POOL=
# Welcome SMS / live A2P outbound. Anything other than true stays in simulation.
TWILIO_A2P_LIVE=false
RESEND_API_KEY=
RESEND_FROM=

# Voice receptionist (Twilio → supabase/functions/inbound-voice-agent).
# VOICE_AI_PROVIDER=elevenlabs | retell | axiom
VOICE_AI_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
RETELL_API_KEY=
RETELL_AGENT_ID=

# Header secret for POST /api/outreach/cron (x-outreach-cron). Server-only.
# Missing or wrong secret always returns 401.
OUTREACH_CRON_SECRET=

# Signs /api/unsubscribe links. Falls back to BETTER_AUTH_SECRET when empty.
OUTREACH_UNSUBSCRIBE_SECRET=

# Master desk. Server-only. The email list is comma-separated.
MASTER_ADMIN_BYPASS_KEY=
MASTER_ADMIN_EMAIL=

# Image / video generation. Server-only. Optional until Autopilot hero compile is live.
REPLICATE_API_TOKEN=

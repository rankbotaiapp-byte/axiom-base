# Copy to .env and fill in. Never commit .env.
# Values below are names only. Set the real values in Vercel as server
# environment variables, except NEXT_PUBLIC_SUPABASE_URL, which is public.

# Postgres connection for Supabase. Required. Server-only.
DATABASE_URL=

# Public app origin, for example https://your-app.vercel.app. Required.
BETTER_AUTH_URL=
# Session signing secret. Required in production.
BETTER_AUTH_SECRET=

# Stay on simulation until a launch is explicitly switched to live.
OUTREACH_MODE=simulation

# Supabase project URL. Public. Used by the simulation script.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase service role. Server-only. Never prefix this with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Server-only. The webhook secret must be the one Stripe shows for
# the production endpoint, not the local CLI listener secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Outreach providers. Stored for launch. Simulation does not call them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM=

# Header secret for POST /api/outreach/cron (x-outreach-cron). Server-only.
OUTREACH_CRON_SECRET=

# Master desk. Server-only. The email list is comma-separated.
MASTER_ADMIN_BYPASS_KEY=
MASTER_ADMIN_EMAIL=

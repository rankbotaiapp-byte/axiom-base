*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# Vercel copies Git blobs into /media. LFS pointers are text and play as a black box.
# Last matching pattern wins — keep storefront media as raw binaries.
public/media/** filter= diff= merge= binary
public/assets/** filter= diff= merge= binary

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://axiom.newera-apps.com

# --- Data (Supabase). Leave blank to run in demo mode (in-memory store). ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI content engine ---
ANTHROPIC_API_KEY=
AXIOM_CONTENT_MODEL=claude-sonnet-4-5

# --- Payments (Stripe). Leave blank to skip checkout and go straight to the live app. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=        # recurring $150/mo price id
STRIPE_PRICE_FIRST_MONTH=    # one-time $1 price id (charged with a 30-day trial on the monthly price)
STRIPE_PRICE_LIFETIME=       # one-time $1000 price id

# --- Security ---
CRON_SECRET=                 # Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes
ADMIN_TOKEN=                 # gate for /admin/* (sign in at /admin/login)

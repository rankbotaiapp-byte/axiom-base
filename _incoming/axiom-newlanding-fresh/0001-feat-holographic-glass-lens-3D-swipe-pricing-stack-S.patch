@@ -0,0 +1,259 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { Drawer } from "vaul";
+import { useNavigate } from "@tanstack/react-router";
+import { EmbeddedCheckout, EmbeddedCheckoutProvider } from "@stripe/react-stripe-js";
+import { loadStripe, type Stripe } from "@stripe/stripe-js";
+import { CheckCircle2, LoaderCircle, Lock, Mail, X } from "lucide-react";
+import { beginLaunchCheckout, confirmLaunchCheckout } from "@/lib/axiom/launch-checkout";
+import { LAUNCH_PLAN_STORAGE_KEY, provisioningPath, type LaunchPlan } from "@/lib/axiom/launch-plans";
+import { ParticleBurst } from "./ParticleBurst";
+import { cn } from "@/lib/utils";
+
+const ACCENT_HEX: Record<LaunchPlan["hue"], string> = {
+  cyan: "#00ffcc",
+  signal: "#ff4fd8",
+  amber: "#f5b942",
+};
+
+const stripeCache = new Map<string, Promise<Stripe | null>>();
+function stripeFor(key: string) {
+  let p = stripeCache.get(key);
+  if (!p) {
+    p = loadStripe(key);
+    stripeCache.set(key, p);
+  }
+  return p;
+}
+
+type Stage =
+  | { kind: "loading" }
+  | { kind: "ready"; sessionId: string; clientSecret: string; publishableKey: string }
+  | { kind: "unconfigured" }
+  | { kind: "confirming" }
+  | { kind: "success"; next: string }
+  | { kind: "error"; message: string };
+
+/**
+ * Frosted-glass slide-up drawer: Stripe Embedded Checkout inline, then a particle-burst
+ * success state that hands the buyer straight to tenant provisioning.
+ */
+export function LaunchCheckoutDrawer({ plan, onClose }: { plan: LaunchPlan | null; onClose: () => void }) {
+  const open = plan !== null;
+  const navigate = useNavigate();
+  const [stage, setStage] = useState<Stage>({ kind: "loading" });
+  const opened = useRef<string | null>(null);
+  const routeTimer = useRef(0);
+
+  const start = useCallback(async (p: LaunchPlan) => {
+    setStage({ kind: "loading" });
+    try {
+      const res = await beginLaunchCheckout({ data: { planId: p.id } });
+      if (res.status === "ready") setStage({ kind: "ready", ...res });
+      else setStage({ kind: "unconfigured" });
+    } catch (err) {
+      setStage({ kind: "error", message: err instanceof Error ? err.message : "Checkout could not open" });
+    }
+  }, []);
+
+  useEffect(() => {
+    if (!plan) {
+      opened.current = null;
+      return;
+    }
+    if (opened.current === plan.id) return;
+    opened.current = plan.id;
+    void start(plan);
+  }, [plan, start]);
+
+  useEffect(() => () => window.clearTimeout(routeTimer.current), []);
+
+  const succeed = useCallback(
+    (p: LaunchPlan, next: string, sessionId: string | null) => {
+      try {
+        sessionStorage.setItem(
+          LAUNCH_PLAN_STORAGE_KEY,
+          JSON.stringify({ planId: p.id, sessionId, settledAt: new Date().toISOString() }),
+        );
+      } catch {
+        /* storage can be unavailable in private modes */
+      }
+      setStage({ kind: "success", next });
+      routeTimer.current = window.setTimeout(() => {
+        void navigate({ href: next });
+      }, 1900);
+    },
+    [navigate],
+  );
+
+  const onComplete = useCallback(() => {
+    if (!plan || stage.kind !== "ready") return;
+    const sessionId = stage.sessionId;
+    setStage({ kind: "confirming" });
+    void confirmLaunchCheckout({ data: sessionId })
+      .then((res) => succeed(plan, res.next, sessionId))
+      .catch((err) =>
+        setStage({ kind: "error", message: err instanceof Error ? err.message : "Payment could not be confirmed" }),
+      );
+  }, [plan, stage, succeed]);
+
+  const locked = stage.kind === "confirming" || stage.kind === "success";
+
+  return (
+    <Drawer.Root
+      open={open}
+      onOpenChange={(next) => {
+        if (!next && !locked) onClose();
+      }}
+      handleOnly
+      dismissible={!locked}
+    >
+      <Drawer.Portal>
+        <Drawer.Overlay className="fixed inset-0 z-[80] bg-obsidian/60 backdrop-blur-[3px]" />
+        <Drawer.Content
+          className="checkout-drawer fixed inset-x-0 bottom-0 z-[90] mx-auto flex max-h-[92dvh] w-full max-w-xl flex-col outline-none"
+          style={{ ["--card-accent" as string]: plan ? ACCENT_HEX[plan.hue] : ACCENT_HEX.cyan }}
+          aria-describedby={undefined}
+        >
+          <div className="checkout-drawer-glass relative flex min-h-0 flex-1 flex-col overflow-hidden rounded-t-[28px]">
+            <Drawer.Handle className="checkout-drawer-handle mx-auto mt-3" />
+            <div className="flex items-start justify-between gap-4 px-6 pt-4">
+              <div>
+                <p className="font-mono text-[10px] uppercase tracking-[0.24em]" style={{ color: "var(--card-accent)" }}>
+                  {plan?.tagline ?? "Checkout"}
+                </p>
+                <Drawer.Title className="mt-1.5 font-display text-2xl text-fg">
+                  {plan ? `Axiom ${plan.name}` : "Checkout"}
+                </Drawer.Title>
+                {plan ? (
+                  <p className="mt-1 text-sm text-muted">
+                    <span className="font-semibold text-fg">{plan.priceLabel}</span> {plan.priceNote}
+                  </p>
+                ) : null}
+              </div>
+              <button
+                type="button"
+                onClick={onClose}
+                disabled={locked}
+                className="grid size-11 shrink-0 place-items-center rounded-full border border-line text-muted transition hover:text-fg disabled:opacity-40"
+                aria-label="Close checkout"
+              >
+                <X className="size-4" />
+              </button>
+            </div>
+
+            <div className="relative mt-5 min-h-[22rem] flex-1 overflow-y-auto overscroll-contain px-4 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:px-6">
+              {plan ? (
+                <StageBody
+                  plan={plan}
+                  stage={stage}
+                  onComplete={onComplete}
+                  onRetry={() => void start(plan)}
+                  onSimulate={() => succeed(plan, provisioningPath(plan.id), null)}
+                />
+              ) : null}
+            </div>
+
+            <p className="flex items-center justify-center gap-1.5 border-t border-line px-6 py-3 text-[11px] text-faint">
+              <Lock className="size-3" aria-hidden /> Payments secured by Stripe · Gear Guardian LLC
+            </p>
+          </div>
+        </Drawer.Content>
+      </Drawer.Portal>
+    </Drawer.Root>
+  );
+}
+
+function StageBody({
+  plan,
+  stage,
+  onComplete,
+  onRetry,
+  onSimulate,
+}: {
+  plan: LaunchPlan;
+  stage: Stage;
+  onComplete: () => void;
+  onRetry: () => void;
+  onSimulate: () => void;
+}) {
+  if (stage.kind === "loading" || stage.kind === "confirming") {
+    return (
+      <div className="grid h-full min-h-[20rem] place-items-center">
+        <div className="flex flex-col items-center gap-3 text-sm text-muted">
+          <LoaderCircle className="size-6 animate-spin" style={{ color: "var(--card-accent)" }} aria-hidden />
+          {stage.kind === "loading" ? "Opening secure checkout…" : "Confirming payment with Stripe…"}
+        </div>
+      </div>
+    );
+  }
+
+  if (stage.kind === "ready") {
+    return (
+      <div className="checkout-embed overflow-hidden rounded-2xl">
+        <EmbeddedCheckoutProvider
+          key={stage.sessionId}
+          stripe={stripeFor(stage.publishableKey)}
+          options={{ clientSecret: stage.clientSecret, onComplete }}
+        >
+          <EmbeddedCheckout />
+        </EmbeddedCheckoutProvider>
+      </div>
+    );
+  }
+
+  if (stage.kind === "success") {
+    return (
+      <div className="relative grid min-h-[22rem] place-items-center overflow-hidden">
+        <ParticleBurst accent={ACCENT_HEX[plan.hue]} />
+        <div className="relative flex flex-col items-center gap-3 text-center">
+          <span className="checkout-success-ring grid size-16 place-items-center rounded-full">
+            <CheckCircle2 className="size-8" style={{ color: "var(--card-accent)" }} aria-hidden />
+          </span>
+          <p className="font-display text-2xl text-fg">You’re in.</p>
+          <p className="max-w-xs text-sm text-muted" aria-live="polite">
+            Provisioning your Axiom tenant — routing you to setup now.
+          </p>
+        </div>
+      </div>
+    );
+  }
+
+  if (stage.kind === "unconfigured") {
+    return (
+      <div className="grid min-h-[20rem] content-center gap-4 text-center">
+        <p className="text-sm text-muted">Card checkout isn’t switched on for this site yet.</p>
+        <a
+          href={`mailto:hello@axiom.shop?subject=${encodeURIComponent(`Axiom ${plan.name}`)}`}
+          className="mx-auto inline-flex min-h-12 items-center gap-2 rounded-full border border-line px-6 font-mono text-xs uppercase tracking-[0.18em] text-fg transition hover:border-accent/60"
+        >
+          <Mail className="size-4" aria-hidden /> Reserve by email
+        </a>
+        {import.meta.env.DEV ? (
+          <button
+            type="button"
+            onClick={onSimulate}
+            className="mx-auto font-mono text-[11px] uppercase tracking-[0.18em] text-faint underline-offset-4 hover:text-fg hover:underline"
+          >
+            Dev only · simulate a paid checkout
+          </button>
+        ) : null}
+      </div>
+    );
+  }
+
+  return (
+    <div className="grid min-h-[20rem] content-center gap-4 text-center">
+      <p className="text-sm text-danger">{stage.message}</p>
+      <button
+        type="button"
+        onClick={onRetry}
+        className={cn(
+          "mx-auto inline-flex min-h-12 items-center rounded-full border border-line px-6",
+          "font-mono text-xs uppercase tracking-[0.18em] text-fg transition hover:border-accent/60",
+        )}
+      >
+        Try again
+      </button>
+    </div>
+  );
+}
diff --git a/src/components/pricing/ParticleBurst.tsx b/src/components/pricing/ParticleBurst.tsx
new file mode 100644
index 0000000..ae8d43f
--- /dev/null
+++ b/src/components/pricing/ParticleBurst.tsx
@@ -0,0 +1,117 @@
+import { useEffect, useRef } from "react";
+
+type Shard = {
+  x: number;
+  y: number;
+  vx: number;
+  vy: number;
+  r: number;
+  vr: number;
+  size: number;
+  hue: number;
+  life: number;
+};
+
+/**
+ * Iridescent glass-shard burst + shockwave ring, drawn on a 2D canvas (no extra WebGL context).
+ * Fires once on mount. Respects reduced motion by drawing nothing.
+ */
+export function ParticleBurst({ accent = "#00ffcc", count = 170 }: { accent?: string; count?: number }) {
+  const ref = useRef<HTMLCanvasElement>(null);
+
+  useEffect(() => {
+    const canvas = ref.current;
+    if (!canvas) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+    const resize = () => {
+      const r = canvas.getBoundingClientRect();
+      canvas.width = Math.max(1, Math.floor(r.width * dpr));
+      canvas.height = Math.max(1, Math.floor(r.height * dpr));
+    };
+    resize();
+
+    const W = () => canvas.width / dpr;
+    const H = () => canvas.height / dpr;
+    const cx = W() / 2;
+    const cy = H() * 0.42;
+    const hues = [178, 195, 300, 320, 45];
+    const shards: Shard[] = Array.from({ length: count }, (_, i) => {
+      const a = (i / count) * Math.PI * 2 + Math.random() * 0.4;
+      const sp = 220 + Math.random() * 520;
+      return {
+        x: cx,
+        y: cy,
+        vx: Math.cos(a) * sp,
+        vy: Math.sin(a) * sp - 120,
+        r: Math.random() * Math.PI,
+        vr: (Math.random() - 0.5) * 14,
+        size: 3 + Math.random() * 9,
+        hue: hues[i % hues.length]! + (Math.random() - 0.5) * 20,
+        life: 1,
+      };
+    });
+
+    let raf = 0;
+    let last = performance.now();
+    const start = last;
+    const tick = (now: number) => {
+      const dt = Math.min(0.033, (now - last) / 1000);
+      last = now;
+      const t = (now - start) / 1000;
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      ctx.clearRect(0, 0, W(), H());
+
+      // Shockwave ring.
+      if (t < 0.9) {
+        const k = t / 0.9;
+        ctx.beginPath();
+        ctx.arc(cx, cy, 20 + k * Math.max(W(), H()) * 0.7, 0, Math.PI * 2);
+        ctx.strokeStyle = accent;
+        ctx.globalAlpha = (1 - k) * 0.7;
+        ctx.lineWidth = 2 + (1 - k) * 6;
+        ctx.stroke();
+      }
+
+      ctx.globalCompositeOperation = "lighter";
+      let alive = 0;
+      for (const s of shards) {
+        if (s.life <= 0) continue;
+        alive += 1;
+        s.vx *= Math.exp(-dt * 1.6);
+        s.vy = s.vy * Math.exp(-dt * 1.6) + 420 * dt;
+        s.x += s.vx * dt;
+        s.y += s.vy * dt;
+        s.r += s.vr * dt;
+        s.life -= dt * 0.55;
+        const shimmer = 0.5 + 0.5 * Math.sin(t * 9 + s.hue);
+        ctx.save();
+        ctx.translate(s.x, s.y);
+        ctx.rotate(s.r);
+        ctx.globalAlpha = Math.max(0, s.life);
+        ctx.fillStyle = `hsl(${s.hue} 95% ${55 + shimmer * 30}%)`;
+        ctx.beginPath();
+        ctx.moveTo(0, -s.size);
+        ctx.lineTo(s.size * 0.55, s.size * 0.6);
+        ctx.lineTo(-s.size * 0.45, s.size * 0.35);
+        ctx.closePath();
+        ctx.fill();
+        ctx.restore();
+      }
+      ctx.globalCompositeOperation = "source-over";
+      ctx.globalAlpha = 1;
+      if (alive > 0) raf = requestAnimationFrame(tick);
+    };
+    raf = requestAnimationFrame(tick);
+    window.addEventListener("resize", resize);
+    return () => {
+      cancelAnimationFrame(raf);
+      window.removeEventListener("resize", resize);
+    };
+  }, [accent, count]);
+
+  return <canvas ref={ref} className="pointer-events-none absolute inset-0 h-full w-full" aria-hidden />;
+}
diff --git a/src/components/pricing/PricingCardStack.tsx b/src/components/pricing/PricingCardStack.tsx
new file mode 100644
index 0000000..633fcf8
--- /dev/null
+++ b/src/components/pricing/PricingCardStack.tsx
@@ -0,0 +1,303 @@
+import { useCallback, useEffect, useRef, useState, type CSSProperties, type KeyboardEvent, type PointerEvent } from "react";
+import { animate, motion, useMotionValue, useReducedMotion, useSpring, useTransform } from "framer-motion";
+import { ArrowLeft, ArrowRight, Check, ChevronsUp } from "lucide-react";
+import { LAUNCH_PLANS, type LaunchPlan } from "@/lib/axiom/launch-plans";
+import { cn } from "@/lib/utils";
+
+const FLING_X = 110;
+const FLING_VX = 600;
+const PROVISION_Y = -120;
+const PROVISION_VY = -700;
+const SPRING = { type: "spring", stiffness: 380, damping: 30 } as const;
+
+const HUE: Record<LaunchPlan["hue"], string> = {
+  cyan: "var(--color-accent)",
+  signal: "var(--color-signal)",
+  amber: "var(--color-amber)",
+};
+
+/**
+ * Tactile 3D card stack for the launch tiers.
+ * Swipe sideways (or arrows / ← →) to cycle tiers. Swipe up, tap the CTA, or press Enter to provision.
+ */
+export function PricingCardStack({ onProvision }: { onProvision: (plan: LaunchPlan) => void }) {
+  const reduce = useReducedMotion() ?? false;
+  const [order, setOrder] = useState<number[]>(() => LAUNCH_PLANS.map((_, i) => i));
+  const front = order[0]!;
+
+  const cycle = useCallback((dir: 1 | -1) => {
+    setOrder((prev) => (dir === 1 ? [...prev.slice(1), prev[0]!] : [prev[prev.length - 1]!, ...prev.slice(0, -1)]));
+  }, []);
+
+  const jumpTo = useCallback((index: number) => {
+    setOrder((prev) => {
+      const at = prev.indexOf(index);
+      return at <= 0 ? prev : [...prev.slice(at), ...prev.slice(0, at)];
+    });
+  }, []);
+
+  function onKey(e: KeyboardEvent<HTMLDivElement>) {
+    if (e.key === "ArrowRight") {
+      e.preventDefault();
+      cycle(1);
+    } else if (e.key === "ArrowLeft") {
+      e.preventDefault();
+      cycle(-1);
+    } else if (e.key === "Enter" && e.target === e.currentTarget) {
+      e.preventDefault();
+      onProvision(LAUNCH_PLANS[front]!);
+    }
+  }
+
+  return (
+    <div className="flex w-full flex-col items-center">
+      <div
+        className="price-stack relative mx-auto outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
+        role="region"
+        aria-roledescription="carousel"
+        aria-label="Axiom launch plans"
+        tabIndex={0}
+        onKeyDown={onKey}
+      >
+        {order
+          .map((planIndex, depth) => ({ planIndex, depth }))
+          .reverse()
+          .map(({ planIndex, depth }) => (
+            <StackCard
+              key={LAUNCH_PLANS[planIndex]!.id}
+              plan={LAUNCH_PLANS[planIndex]!}
+              depth={depth}
+              reduce={reduce}
+              onFling={cycle}
+              onProvision={onProvision}
+            />
+          ))}
+      </div>
+
+      <div className="mt-6 flex items-center gap-4">
+        <button
+          type="button"
+          onClick={() => cycle(-1)}
+          className="grid size-11 place-items-center rounded-full border border-line bg-obsidian/60 text-muted backdrop-blur-md transition hover:border-accent/60 hover:text-fg"
+          aria-label="Previous plan"
+        >
+          <ArrowLeft className="size-4" />
+        </button>
+        <div className="flex items-center gap-2" role="tablist" aria-label="Choose a plan">
+          {LAUNCH_PLANS.map((plan, i) => (
+            <button
+              key={plan.id}
+              type="button"
+              role="tab"
+              aria-selected={i === front}
+              aria-label={plan.name}
+              onClick={() => jumpTo(i)}
+              className="grid h-11 min-w-8 place-items-center"
+            >
+              <span
+                className={cn("block h-1.5 rounded-full transition-all duration-300", i === front ? "w-7" : "w-2.5 bg-fg/25")}
+                style={i === front ? { background: HUE[plan.hue] } : undefined}
+              />
+            </button>
+          ))}
+        </div>
+        <button
+          type="button"
+          onClick={() => cycle(1)}
+          className="grid size-11 place-items-center rounded-full border border-line bg-obsidian/60 text-muted backdrop-blur-md transition hover:border-accent/60 hover:text-fg"
+          aria-label="Next plan"
+        >
+          <ArrowRight className="size-4" />
+        </button>
+      </div>
+      <p className="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-faint">
+        Swipe to browse · swipe <ChevronsUp className="inline size-3 align-[-2px]" aria-hidden /> to provision
+      </p>
+    </div>
+  );
+}
+
+function StackCard({
+  plan,
+  depth,
+  reduce,
+  onFling,
+  onProvision,
+}: {
+  plan: LaunchPlan;
+  depth: number;
+  reduce: boolean;
+  onFling: (dir: 1 | -1) => void;
+  onProvision: (plan: LaunchPlan) => void;
+}) {
+  const isFront = depth === 0;
+  const x = useMotionValue(0);
+  const y = useMotionValue(0);
+  const tiltX = useSpring(0, { stiffness: 220, damping: 18 });
+  const tiltY = useSpring(0, { stiffness: 220, damping: 18 });
+  const dragRotY = useTransform(x, [-240, 240], [-26, 26]);
+  const dragRotZ = useTransform(x, [-240, 240], [-9, 9]);
+  const dragRotX = useTransform(y, [-200, 0, 200], [18, 0, -10]);
+  const rotateY = useTransform(() => dragRotY.get() + tiltY.get());
+  const rotateX = useTransform(() => dragRotX.get() + tiltX.get());
+  const provisionGlow = useTransform(y, [PROVISION_Y * 1.2, 0], [1, 0]);
+  const sheenRef = useRef<HTMLDivElement>(null);
+  const flinging = useRef(false);
+  const drag = useRef<{ id: number; sx: number; sy: number; samples: { x: number; y: number; t: number }[] } | null>(null);
+
+  useEffect(() => {
+    if (!isFront) {
+      tiltX.set(0);
+      tiltY.set(0);
+    }
+  }, [isFront, tiltX, tiltY]);
+
+  function onPointerDown(e: PointerEvent<HTMLDivElement>) {
+    if (!isFront || flinging.current || e.button > 0) return;
+    e.currentTarget.setPointerCapture(e.pointerId);
+    drag.current = { id: e.pointerId, sx: e.clientX, sy: e.clientY, samples: [{ x: e.clientX, y: e.clientY, t: performance.now() }] };
+  }
+
+  function onPointerUp(e: PointerEvent<HTMLDivElement>) {
+    const d = drag.current;
+    if (!d || d.id !== e.pointerId) return;
+    drag.current = null;
+    const now = performance.now();
+    const recent = d.samples.filter((s) => now - s.t < 120);
+    const first = recent[0] ?? d.samples[d.samples.length - 1]!;
+    const dt = Math.max(16, now - first.t) / 1000;
+    const velocity = { x: (e.clientX - first.x) / dt, y: (e.clientY - first.y) / dt };
+    const offset = { x: e.clientX - d.sx, y: e.clientY - d.sy };
+    if (Math.hypot(offset.x, offset.y) < 6) {
+      void animate(x, 0, SPRING);
+      void animate(y, 0, SPRING);
+      return;
+    }
+    onDragEnd(offset, velocity);
+  }
+
+  function onPointerMove(e: PointerEvent<HTMLDivElement>) {
+    const d = drag.current;
+    if (d && d.id === e.pointerId) {
+      // Rubber-band the vertical axis so a sideways swipe stays sideways.
+      x.set(e.clientX - d.sx);
+      y.set((e.clientY - d.sy) * 0.7);
+      d.samples.push({ x: e.clientX, y: e.clientY, t: performance.now() });
+      if (d.samples.length > 8) d.samples.shift();
+      return;
+    }
+    if (!isFront || reduce) return;
+    const r = e.currentTarget.getBoundingClientRect();
+    const px = (e.clientX - r.left) / r.width;
+    const py = (e.clientY - r.top) / r.height;
+    tiltY.set((px - 0.5) * 16);
+    tiltX.set((0.5 - py) * 12);
+    sheenRef.current?.style.setProperty("--mx", `${px * 100}%`);
+    sheenRef.current?.style.setProperty("--my", `${py * 100}%`);
+  }
+
+  function onPointerLeave() {
+    tiltX.set(0);
+    tiltY.set(0);
+  }
+
+  function onDragEnd(offset: { x: number; y: number }, velocity: { x: number; y: number }) {
+    if (offset.y < PROVISION_Y || velocity.y < PROVISION_VY) {
+      void animate(y, -70, { ...SPRING, velocity: velocity.y }).then(() => void animate(y, 0, SPRING));
+      void animate(x, 0, SPRING);
+      onProvision(plan);
+      return;
+    }
+    if (Math.abs(offset.x) > FLING_X || Math.abs(velocity.x) > FLING_VX) {
+      const dir = (offset.x || velocity.x) > 0 ? 1 : -1;
+      flinging.current = true;
+      void animate(x, dir * 560, { duration: reduce ? 0 : 0.3, ease: [0.2, 0.8, 0.2, 1] }).then(() => {
+        onFling(1);
+        x.jump(0);
+        y.jump(0);
+        flinging.current = false;
+      });
+      void animate(y, offset.y * 0.4, SPRING);
+      return;
+    }
+    void animate(x, 0, SPRING);
+    void animate(y, 0, SPRING);
+  }
+
+  const accent = HUE[plan.hue];
+
+  return (
+    <motion.div
+      className="price-card absolute inset-0"
+      style={
+        {
+          x,
+          y,
+          rotateX: isFront ? rotateX : 0,
+          rotateY: isFront ? rotateY : 0,
+          rotateZ: isFront ? dragRotZ : 0,
+          zIndex: 10 - depth,
+          "--card-accent": accent,
+        } as unknown as CSSProperties
+      }
+      initial={false}
+      animate={{
+        scale: 1 - depth * 0.06,
+        translateY: depth * 22,
+        translateZ: -depth * 70,
+        opacity: depth > 2 ? 0 : 1 - depth * 0.22,
+        filter: depth ? `blur(${depth * 1.2}px) saturate(0.8)` : "blur(0px) saturate(1)",
+      }}
+      transition={reduce ? { duration: 0 } : SPRING}
+      onPointerDown={onPointerDown}
+      onPointerUp={onPointerUp}
+      onPointerCancel={onPointerUp}
+      onPointerMove={onPointerMove}
+      onPointerLeave={onPointerLeave}
+      aria-hidden={!isFront}
+      inert={!isFront}
+    >
+      <div className="price-card-face">
+        <div ref={sheenRef} className="price-card-sheen" aria-hidden />
+        <motion.div className="price-card-provision" style={{ opacity: provisionGlow }} aria-hidden />
+
+        <div className="relative flex h-full flex-col p-6 sm:p-7">
+          <div className="flex items-center justify-between gap-3">
+            <p className="font-mono text-[10px] uppercase tracking-[0.24em]" style={{ color: accent }}>
+              {plan.tagline}
+            </p>
+            {plan.id === "lifetime" ? (
+              <span className="rounded-full border border-signal/40 bg-signal/10 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.18em] text-signal">
+                Best value
+              </span>
+            ) : null}
+          </div>
+          <h3 className="mt-3 font-display text-3xl text-fg">{plan.name}</h3>
+          <div className="mt-4 flex items-baseline gap-2">
+            <span className="font-display text-5xl font-semibold tracking-tight text-fg">{plan.priceLabel}</span>
+          </div>
+          <p className="mt-1 text-sm text-muted">{plan.priceNote}</p>
+
+          <ul className="mt-6 grid gap-2.5">
+            {plan.features.map((feature) => (
+              <li key={feature} className="flex items-start gap-2.5 text-sm text-fg/90">
+                <Check className="mt-0.5 size-4 shrink-0" style={{ color: accent }} aria-hidden />
+                <span>{feature}</span>
+              </li>
+            ))}
+          </ul>
+
+          <button
+            type="button"
+            onPointerDownCapture={(e) => e.stopPropagation()}
+            onClick={() => onProvision(plan)}
+            className="price-card-cta mt-auto inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full px-6 py-3 font-mono text-xs uppercase tracking-[0.18em]"
+          >
+            {plan.cta}
+            <ChevronsUp className="size-4" aria-hidden />
+          </button>
+        </div>
+      </div>
+    </motion.div>
+  );
+}
